# Generation
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Judge
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
JUDGE_API_KEY=
# Optional fallback if you prefer this name instead of JUDGE_API_KEY
GEMINI_API_KEY=

# LLM-first job parsing
USE_LLM_JOB_PARSER=1

# Optional heavy embeddings
USE_SENTENCE_TRANSFORMERS=0

# Storage backend
STORAGE_BACKEND=local

# Databricks backend (only needed when STORAGE_BACKEND=databricks)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_BRONZE_JOB_ADS_TABLE=bronze_job_ads
DATABRICKS_BRONZE_ASSIGNMENT_VERSIONS_TABLE=bronze_assignment_versions
DATABRICKS_BRONZE_REVIEWER_FEEDBACK_TABLE=bronze_reviewer_feedback
DATABRICKS_BRONZE_CANDIDATE_FEEDBACK_TABLE=bronze_candidate_feedback
DATABRICKS_BRONZE_REVIEW_DECISIONS_TABLE=bronze_review_decisions
DATABRICKS_SILVER_PARSED_JOBS_TABLE=silver_parsed_jobs
DATABRICKS_SILVER_ASSIGNMENT_VERSIONS_TABLE=silver_assignment_versions
DATABRICKS_SILVER_REVIEWER_FEEDBACK_TABLE=silver_reviewer_feedback
DATABRICKS_SILVER_CANDIDATE_FEEDBACK_TABLE=silver_candidate_feedback
DATABRICKS_SILVER_REVIEW_DECISIONS_TABLE=silver_review_decisions
DATABRICKS_GOLD_KPI_SUMMARY_TABLE=gold_kpi_summary
DATABRICKS_GOLD_LATEST_ASSIGNMENTS_TABLE=gold_latest_assignment_versions
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default

# Optional project paths
APP_DATA_DIR=data
RAW_DIR=data/raw
PROCESSED_DIR=data/processed
FEEDBACK_DIR=data/feedback
PROMPT_FILE=prompts/assignment_prompt.txt
